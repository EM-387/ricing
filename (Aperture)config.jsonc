// Load with --config examples/2.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
       "type": "kitty",
       "source": "~/.config/fastfetch/rei.jpg",
       "height": 11	
    },

	





    "display": {
        "separator": "  ",
        "constants": [
            "=============================="
        ]
    },
    "modules": [
        {
            "type": "custom",
            "format": "+{$1}{$1}+",
            "outputColor": "#df9711"
        },
        {   
	    "key": "Welcome",
            "type": "title", //prints user
            "keyWidth": "90"
        },
        {
            "type": "custom",
            "format": "+{$1}={$1}+",
            "outputColor": "#df9711"
        },
        {
            "type": "custom",
            "format": " {#90}  {#31}  {#32}  {#33}  {#34}  {#35}  {#36}  {#37}  {#38}  {#39}       {#38}  {#37}  {#36}  {#35}  {#34}  {#33}  {#32}  {#31}  {#90}"
        },
        {
            "type": "custom",
            "format": "+{$1}{$1}+",
            "outputColor": "#df9711"
        },
        {
            "type": "os",
            "key": "{icon} OS",
            "keyColor": "#faa6d7"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "#faa6d7"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "#faa6d7"
        },
        {
            "type": "shell",
            "key": "│ └",
            "keyColor": "#faa6d7"
        },
        {
            "type": "wm",
            "key": " DE/WM",
            "keyColor": "#cd9542"
        },
        {
            "type": "lm",
            "key": "│ ├󰧨",
            "keyColor": "#cd9542"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "#cd9542"
        },
        {
            "type": "icons",
            "key": "│ ├󰀻",
            "keyColor": "#cd9542"
        },
        {
            "type": "terminal",
            "key": "│ └",
            "keyColor": "#cd9542"
        },
        /*{
            "type": "wallpaper",
            "key": "│ 󰸉",
            "keyColor": "#cd9542"
        },*/
        {
            "type": "host",
            "key": "󰌢 PC",
            "keyColor": "#16ba0c"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠",
            "keyColor": "#16ba0c"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "#16ba0c"
        },
        {
            "type": "disk",
            "key": "│ ├",
            "keyColor": "#16ba0c"
        },
        {
            "type": "memory",
            "key": "│ ├󰑭",
            "keyColor": "#16ba0c"
        },
        {
            "type": "swap",
            "key": "│ ├󰓡",
            "keyColor": "#16ba0c"
        },
        {
            "type": "uptime",
            "key": "│ ├󰅐",
            "keyColor": "#16ba0c"
        },
        {
            "type": "display",
            "key": "│ └󰍹",
            "keyColor": "#16ba0c"
        },
        {
            "type": "sound",
            "key": " SND",
            "keyColor": "#a8f2f1"
        },
        {
            "type": "player",
            "key": "│ ├󰥠",
            "keyColor": "#a8f2f1"
        },
        {
            "type": "media",
            "key": "│ └󰝚",
            "keyColor": "#a8f2f1"
        },
        {
            "type": "custom",
            "format": "+{$1}{$1}+",
            "outputColor": "#df9711"
        },
        "break",
        {
            "type": "custom",
            "format": " {#90}  {#31}  {#32}  {#33}  {#34}  {#35}  {#36}  {#37}  {#38}  {#39}       {#38}  {#37}  {#36}  {#35}  {#34}  {#33}  {#32}  {#31}  {#90}"
        }
    ]
}
