{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
 "logo": {
    "source": "~/Pictures/image.png", // replace "~/Pictures/image.png" with the path to the image you want as the logo
    "type": "kitty",
    "width": 30,
//    "height": 20,
    "padding": {
      "top": 3,
      "left": 1,
      "key": "hello"
    },
  },
  "display": {
    "separator": "    "
  },
  "modules": [
  "break",
    {
      "type": "custom",
      "format": "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
    },
    "break",

    {
      "type": "kernel",
      "key": "│    os",
      "keyColor": "white"
    },
    {
      "type": "packages",
      "key": "│  󰮯  packages",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "│  󰨇  window manager",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│    terminal",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "│    shell",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "custom",
      "format": "┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫"
    },
    "break",
    {
      "type": "host",
      "key": "│    device",
      "keyColor": "bright_blue"
    },
    {
      "type": "cpu",
      "key": "│    cpu",
      "keyColor": "bright_green"
    },
    {
      "type": "gpu",
      "key": "│  󱤓  gpu",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "│  󰍛  memory",
      "keyColor": "bright_yellow"
    },
    {
      "type": "disk",
      "key": "│    disk",
      "keyColor": "bright_cyan"
    },

    "break",
    {
      "keyColor": "#ff5500",
      "type": "custom",
      "format": "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",

    }

    ,
    {
    "type":"break"
    },
    {
    "type": "colors"
    },

  ]
}
