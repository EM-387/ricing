{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
 "logo": {
    "source": "~/Pictures/Icons/rei.png",
    "type": "kitty",
    "width": 30,
//    "height": 20,
    "padding": {
      "top": 3,
      "left": 1,
      "key": "hello"
    },

  },
  "display": {
    "separator": " 🯛    "
  },
  "modules": [
      {
    "type":"break"
    },
    {
    "type":"break"
    },
    {
      "type": "custom",
      "format": "╔════════════════════════════════════════════════════════════════╕ "
    },

    {
      "type": "custom",
      "format": "║  Software"
    },

    {
      "type": "kernel",
      "key": "╟    Linux",
      "keyColor": "#a49ec7"
    },
    {
      "type": "packages",
      "key": "╟  󰮯  Packages",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "╟  󰨇  Window Manager",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "╟    Terminal",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "╟    Shell",
      "keyColor": "#898895"
    },

    {
      "type": "custom",
      "format": "║"
    },

    {
      "type": "custom",
      "format": "╠════════════════════════════════════════════════════════════════╡"
    },

    {
      "type": "custom",
      "format": "║  Hardware"
    },

    {
      "type": "host",
      "key": "╟    Host",
      "keyColor": "bright_blue"
    },
    {
      "type": "cpu",
      "key": "╟    CPU",
      "keyColor": "bright_green"
    },
    {
      "type": "gpu",
      "key": "╟  󰋫  GPU",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "╟    Memory",
      "keyColor": "bright_yellow"
    },
    {
      "type": "disk",
      "key": "╟  󰋊  Disk",
      "keyColor": "bright_cyan"
    },

    {
      "type": "custom",
      "format": "║"
    },

    {
      "keyColor": "#ff5500",
      "type": "custom",
      "format": "╚════════════════════════════════════════════════════════════════╛",

    }

    ,
    {
    "type":"break"
    },
    {
    "type": "colors"
    },
    {
    "type":"break"
    },

  ]
}
