;------------------------------------------
;---------------bar defining---------------
;------------------------------------------

(defwidget bar0 []
  (box :class "bar"
    (centerbox :orientation "h"
      (soundbutton&audio)
      (volume)
      (powermenu)
    )
))

(defwidget bar1 []
  (box :class "bar"
    (centerbox :orientation "h"
      (soundbutton&audio)
      (music)
      (powermenu)
    )
))

;---------------------------------------------
;---------------widget defining---------------
;---------------------------------------------

(defwidget powermenu[]
  (box :class "baka"
    :halign "end"
    time
  (button :onclick "mpv /path/to/sound & wofi-power-menu" "⏻")
))


(defwidget soundbutton&audio[]
  (box :class "soundbutton"
    :halign "start"
    (button :tooltip "soundbutton"
      :onclick "mpv /path/to/sound && wait"
      "ᗜˬᗜ"
    )

    (metric :label "volume"
            :value volume
            :onchange "amixer -D pulse sset Master {}%")
))


(defwidget volume []
  (box :class "music"
    :orientation "h"
    :space-evenly false
    :halign "center"
    {music != "" ? "Now playing: ${music}" : ""}
))

(defwidget music []
  (box :class "music"
    :orientation "h"
    :space-evenly false
    :halign "center"
    {music != "" ? "Now playing: ${music}" : ""}
))


(defwidget metric [label value onchange]
  (box :orientation "h"
    :class "metric"
    :space-evenly false
    (box :class "label" label)
    (scale :min 0
      :max 101
      :active {onchange != ""}
      :value value
      :onchange onchange)
))

;--------------------------------------------------------------------
;---------------whatever that thing is called defining---------------
;--------------------------------------------------------------------

(deflisten music :initial ""
  "playerctl --follow metadata --format '{{ title }}' || true")

(defpoll volume :interval "0.2s"
  "scripts/getvol")

(defpoll time :interval "60s"
  "date '+%H:%M | %d/%m/%Y'"
)

;---------------------------------------------
;---------------window defining---------------
;---------------------------------------------

(defwindow bar0
  :monitor 0
  :windowtype "dock"
  :geometry (geometry
    :x "0%"
    :y "1px"
    :width "90%"
    :height "10px"
    :anchor "top center")
    :reserve (struts :side "top" :distance "4%"
  )
(bar0))

(defwindow bar1
  :monitor 1
  :windowtype "dock"
  :geometry (geometry
    :x "0%"
    :y "1px"
    :width "90%"
    :height "10px"
    :anchor "top center")
    :reserve (struts :side "top" :distance "4%")
(bar1))
