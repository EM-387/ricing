;-------------------------------------------------
;----------------------Notes----------------------
;--My sound button is Cirno from Touhou-----------
;--saying "baka" & has a fumo emoticon as the-----
;--text. Both can be changed to whatever you------
;--want by simply changing the audio file path----
;--& the text in lines 54 and 55 respectively.----
;-------------------------------------------------
;--I have it set so that when the power menu is---
;--opened it plays the buzzer sound from Poral 2.-
;--This is simply an extra thing I added for fun--
;--and can be altered by changing the path in-----
;--line z, or completely removed.-----------------
;-------------------------------------------------

;------------------------------------------
;---------------Bar defining---------------
;------------------------------------------

(defwidget bar0 []
  (box :class "bar"
    (centerbox :orientation "h"
      (soundbutton&audio)
      (volume)
      (powermenu)
    )
))

(defwidget bar1 []
  (box :class "bar"
    (centerbox :orientation "h"
      (soundbutton&audio)
      (music)
      (powermenu)
    )
))

;---------------------------------------------
;---------------Widget defining---------------
;---------------------------------------------

(defwidget powermenu[]
  (box :class "baka"
    :halign "end"
    time
  (button :onclick "mpv /path/to/sound & wofi-power-menu" "⏻")
))


(defwidget soundbutton&audio[]
  (box :class "soundbutton"
    :halign "start"
    (button :tooltip "soundbutton"
      :onclick "mpv /path/to/sound && wait"
      "ᗜˬᗜ"
    )

    (metric :label "volume"
            :value volume
            :onchange "amixer -D pulse sset Master {}%")
))


(defwidget volume []
  (box :class "music"
    :orientation "h"
    :space-evenly false
    :halign "center"
    {music != "" ? "Now playing: ${music}" : ""}
))

(defwidget music []
  (box :class "music"
    :orientation "h"
    :space-evenly false
    :halign "center"
    {music != "" ? "Now playing: ${music}" : ""}
))


(defwidget metric [label value onchange]
  (box :orientation "h"
    :class "metric"
    :space-evenly false
    (box :class "label" label)
    (scale :min 0
      :max 101
      :active {onchange != ""}
      :value value
      :onchange onchange)
))

;--------------------------------------------------------------------
;---------------Whatever that thing is called defining---------------
;---------------Includes the volume slider & the clock---------------
;--------------------------------------------------------------------

(deflisten music :initial ""
  "playerctl --follow metadata --format '{{ title }}' || true")

(defpoll volume :interval "0.2s"
  "scripts/getvol")

(defpoll time :interval "60s"
  "date '+%H:%M | %d/%m/%Y'"
)

;---------------------------------------------
;---------------Window defining---------------
;---------------------------------------------

(defwindow bar0
  :monitor 0
  :windowtype "dock"
  :geometry (geometry
    :x "0%"
    :y "1px"
    :width "90%"
    :height "10px"
    :anchor "top center")
    :reserve (struts :side "top" :distance "4%"
  )
(bar0))

(defwindow bar1
  :monitor 1
  :windowtype "dock"
  :geometry (geometry
    :x "0%"
    :y "1px"
    :width "90%"
    :height "10px"
    :anchor "top center")
    :reserve (struts :side "top" :distance "4%")
(bar1))
